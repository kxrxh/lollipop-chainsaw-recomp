+void D3D12GraphicsSystem::OnHostGpuLossFromAnyThread(bool is_responsible) {
+  auto* device = static_cast<ui::d3d12::D3D12Provider*>(provider())->GetDevice();
+  // The presenter may detect device loss before the command processor does.
