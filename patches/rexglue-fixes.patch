+  VkBufferImageCopy region{};
+  region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.imageExtent = {extent.width, extent.height, 1};
+  funcs.vkCmdCopyImageToBuffer(commands, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                               capture->buffer, 1, &region);
+  const VkBufferMemoryBarrier host_read{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+                                        nullptr,
+                                        VK_ACCESS_TRANSFER_WRITE_BIT,
+                                        VK_ACCESS_HOST_READ_BIT,
+                                        VK_QUEUE_FAMILY_IGNORED,
+                                        VK_QUEUE_FAMILY_IGNORED,
+                                        capture->buffer,
+                                        0,
+                                        VK_WHOLE_SIZE};
+  std::swap(barrier.oldLayout, barrier.newLayout);
+  std::swap(barrier.srcAccessMask, barrier.dstAccessMask);
+  funcs.vkCmdPipelineBarrier(commands, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_HOST_BIT | kGuestOutputInternalStageMask, 0, 0,
+                             nullptr, 1, &host_read, 1, &barrier);
+
+  const VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, nullptr, 0};
+  if (funcs.vkEndCommandBuffer(commands) != VK_SUCCESS ||
+      funcs.vkCreateFence(device, &fence_info, nullptr, &capture->fence) != VK_SUCCESS) {
+    return Err<GuestFrame>(ErrorCategory::kRuntime, "Could not record guest output readback");
+  }
+  VkSubmitInfo submit{};
+  submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &commands;
+  {
+    const auto queue = vulkan_device_->AcquireQueue(family, 0);
+    if (funcs.vkQueueSubmit(queue.GetQueue(), 1, &submit, capture->fence) != VK_SUCCESS) {
+      return Err<GuestFrame>(ErrorCategory::kRuntime, "Could not submit guest output readback");
+    }
+  }
+  const auto status = funcs.vkWaitForFences(device, 1, &capture->fence, VK_TRUE, kTimeoutNs);
+  if (status != VK_SUCCESS) {
+    if (status != VK_ERROR_DEVICE_LOST) {
+      capture->submitted = true;
+      pending_capture_ = std::move(capture);
+    }
+    return Err<GuestFrame>(ErrorCategory::kRuntime, "Could not complete guest output readback");
+  }
+
+  GuestFrame frame{extent.width, extent.height, {}};
+  frame.rgba.resize(pixels * 4);
+  void* mapping = nullptr;
+  if (funcs.vkMapMemory(device, capture->memory, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+    return Err<GuestFrame>(ErrorCategory::kRuntime, "Could not map guest output readback");
+  }
+  const VkMappedMemoryRange range{VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, capture->memory,
+                                  0, VK_WHOLE_SIZE};
+  if (funcs.vkInvalidateMappedMemoryRanges(device, 1, &range) != VK_SUCCESS) {
+    funcs.vkUnmapMemory(device, capture->memory);
+    return Err<GuestFrame>(ErrorCategory::kRuntime,
+                           "Could not invalidate guest output readback cache");
+  }
+  const auto* values = static_cast<const u32*>(mapping);
+  for (size_t i = 0; i < pixels; ++i) {
+    ConvertGuestPixel(values[i], frame.rgba.data() + i * 4);
+  }
+  funcs.vkUnmapMemory(device, capture->memory);
+  return frame;
+}
