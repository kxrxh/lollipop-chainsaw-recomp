+// A completely read-back page can be reconstructed from guest memory after invalidation.
+void SharedMemory::MarkReadbackPagesCpuBacked(uint32_t start, uint32_t length) {
+  if (start >= kBufferSize || length > kBufferSize - start) {
+    return;
+  }
+  const uint32_t page_mask = (1u << page_size_log2_) - 1;
+  auto lock = AcquireLock();
+  for (uint32_t page = (start + page_mask) >> page_size_log2_;
+       page < (start + length) >> page_size_log2_; ++page) {
+    system_page_flags_valid_and_gpu_written_[page >> 6] &= ~(uint64_t(1) << (page & 63));
+  }
+}
+
+bool SharedMemory::TryMirrorCpuBackedCopy(uint32_t source, uint32_t destination, uint32_t length) {
+  if (!length || length > kBufferSize || source > kBufferSize - length ||
+      destination > kBufferSize - length ||
+      (source < destination + length && destination < source + length)) {
+    return false;
+  }
+  auto lock = AcquireLock();
+  for (uint32_t page = source >> page_size_log2_; page <= (source + length - 1) >> page_size_log2_;
+       ++page) {
+    const auto mask = uint64_t(1) << (page & 63);
+    if (!(system_page_flags_valid_[page >> 6] & mask) ||
+        (system_page_flags_valid_and_gpu_written_[page >> 6] & mask)) {
+      return false;
+    }
+  }
+  auto src = physical_memory_.GetReadOnlyPhysicalSpan({source, length});
+  auto dst = physical_memory_.GetWritablePhysicalSpan({destination, length});
+  if (!src || !dst) {
+    return false;
+  }
+  std::memcpy(dst->data(), src->data(), length);
+  return true;
+}
