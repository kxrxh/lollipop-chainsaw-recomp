+Result<GuestFrame> D3D12Presenter::CaptureGuestFrame() {
+  constexpr DWORD kTimeoutMs = 1500;
+  if (pending_capture_) {
+    if (!pending_capture_->submission.AwaitAllSubmissionsCompletion(kTimeoutMs)) {
+      return Err<GuestFrame>(ErrorCategory::kRuntime,
+                             "The previous guest output copy is still pending");
+    }
+    pending_capture_.reset();
+  }
+
+  auto capture = std::make_unique<GuestOutputCapture>();
+  {
+    u32 mailbox;
+    auto consumer_lock = ConsumeGuestOutput(mailbox, nullptr, nullptr);
+    if (mailbox != UINT32_MAX) {
+      capture->output = guest_output_resources_[mailbox].second;
+    }
+  }
+  if (!capture->output) {
+    return Err<GuestFrame>(ErrorCategory::kRuntime, "No guest output frame is available");
+  }
+
+  auto* device = provider_.GetDevice();
+  auto* queue = provider_.GetDirectQueue();
+  const auto texture = capture->output->GetDesc();
+  D3D12_TEXTURE_COPY_LOCATION destination{};
+  destination.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  UINT64 size = 0;
+  device->GetCopyableFootprints(&texture, 0, 1, 0, &destination.PlacedFootprint, nullptr, nullptr,
+                                &size);
+  D3D12_RESOURCE_DESC buffer_desc;
+  objects::FillBufferResourceDesc(buffer_desc, size, D3D12_RESOURCE_FLAG_NONE);
+
+  if (FAILED(device->CreateCommittedResource(
+          &objects::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &buffer_desc,
+          D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&capture->buffer))) ||
+      FAILED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                            IID_PPV_ARGS(&capture->allocator))) ||
+      FAILED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, capture->allocator.Get(),
+                                       nullptr, IID_PPV_ARGS(&capture->list))) ||
+      !capture->submission.Initialize(device, queue)) {
+    return Err<GuestFrame>(ErrorCategory::kRuntime, "Could not allocate guest output readback");
+  }
+
+  D3D12_RESOURCE_BARRIER barrier{};
+  barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  barrier.Transition = {capture->output.Get(), D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,
+                        kGuestOutputInternalState, D3D12_RESOURCE_STATE_COPY_SOURCE};
+  capture->list->ResourceBarrier(1, &barrier);
+  destination.pResource = capture->buffer.Get();
+  D3D12_TEXTURE_COPY_LOCATION source{};
+  source.pResource = capture->output.Get();
+  source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  capture->list->CopyTextureRegion(&destination, 0, 0, 0, &source, nullptr);
+  std::swap(barrier.Transition.StateBefore, barrier.Transition.StateAfter);
+  capture->list->ResourceBarrier(1, &barrier);
+  if (FAILED(capture->list->Close())) {
+    return Err<GuestFrame>(ErrorCategory::kRuntime, "Could not record guest output readback");
+  }
+
+  ID3D12CommandList* list = capture->list.Get();
+  queue->ExecuteCommandLists(1, &list);
+  if (!capture->submission.NextSubmission() ||
+      !capture->submission.AwaitAllSubmissionsCompletion(kTimeoutMs)) {
+    // The queue still owns the recorded copy even if the request stops waiting.
+    pending_capture_ = std::move(capture);
+    return Err<GuestFrame>(ErrorCategory::kRuntime, "Could not complete guest output readback");
+  }
+  if (FAILED(device->GetDeviceRemovedReason())) {
+    return Err<GuestFrame>(ErrorCategory::kRuntime,
+                           "Graphics device lost during guest output readback");
+  }
+
+  GuestFrame frame{static_cast<u32>(texture.Width), texture.Height, {}};
+  frame.rgba.resize(size_t(frame.width) * frame.height * 4);
+  const auto& footprint = destination.PlacedFootprint;
+  const D3D12_RANGE read_range{size_t(footprint.Offset), size_t(size)};
+  void* data = nullptr;
+  if (FAILED(capture->buffer->Map(0, &read_range, &data))) {
+    return Err<GuestFrame>(ErrorCategory::kRuntime, "Could not map guest output readback");
+  }
+  const auto* bytes = static_cast<const u8*>(data) + footprint.Offset;
+  for (u32 y = 0; y < frame.height; ++y) {
+    const auto* source_row =
+        reinterpret_cast<const u32*>(bytes + size_t(y) * footprint.Footprint.RowPitch);
+    auto* destination_row = frame.rgba.data() + size_t(y) * frame.width * 4;
+    for (u32 x = 0; x < frame.width; ++x) {
+      ConvertGuestPixel(source_row[x], destination_row + size_t(x) * 4);
+    }
+  }
+  const D3D12_RANGE written_range{0, 0};
+  capture->buffer->Unmap(0, &written_range);
+  return frame;
+}
