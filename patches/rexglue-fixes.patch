new file mode 100644
index 00000000..dee1bfe7
--- /dev/null
+++ b/include/rex/gpu/copy_export.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <cmath>
+#include <optional>
+#include <utility>
+
+#include <rex/xenos/register.h>
+
+namespace rex::gpu {
+
+struct CpuCopyRange {
+  uint32_t source;
+  uint32_t destination;
+  uint32_t length;
+};
+
+// This point-list shader copies 64 bytes per vertex, rebasing exports by c7.x.
+inline std::optional<CpuCopyRange> GetLollipopCopyExport(const xenos::RegisterFile& regs, u32 count,
+                                                         u32 base_address_dwords, u32 size_bytes) {
+  const uint32_t first = regs.Get<xenos::reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t c = std::to_underlying(xenos::Register::SHADER_CONSTANT_000_X);
+  const float export_base = regs.Get<float>(c + 7 * 4);
+  if (!count || count > 0xFFFFFFu / 16 || first > 0xFFFFFFu - count ||
+      regs.Get<xenos::reg::VGT_MIN_VTX_INDX>().min_indx > first ||
+      regs.Get<xenos::reg::VGT_MAX_VTX_INDX>().max_indx < first + count - 1 ||
+      regs.Get<xenos::reg::SQ_VS_CONST>().base != 0 || !std::isfinite(export_base) ||
+      export_base < 0 || export_base > float(first) || std::floor(export_base) != export_base) {
+    return std::nullopt;
+  }
+  const auto source = regs.GetVertexFetch(95);
+  const auto stream = regs.GetMemExportStream(6);
+  const uint32_t destination_first = first - uint32_t(export_base);
+  if (source.type != xenos::FetchConstantType::kVertex || source.endian != xenos::Endian::k8in32 ||
+      source.size < (first + count) * 16 || stream.base_address != base_address_dwords ||
+      stream.const_0x1 != 1 || stream.dword_1 != 0x4b000000 || stream.dword_2 != 0x4b021a01 ||
+      stream.const_0x96 != 0x96 || stream.index_count < (destination_first + count) * 8 ||
+      size_bytes != stream.index_count * 8 || regs.Get<float>(c + 255 * 4) != 0.0f ||
+      regs.Get<float>(c + 255 * 4 + 1) != 1.0f || regs.Get<float>(c + 255 * 4 + 2) != 4.0f ||
+      regs.Get<float>(c + 255 * 4 + 3) != 8.0f) {
+    return std::nullopt;
+  }
+  const uint64_t source_address = (uint64_t(source.address) << 2) + uint64_t(first) * 64;
+  const uint64_t destination =
+      (uint64_t(stream.base_address) << 2) + uint64_t(destination_first) * 64;
+  const uint32_t length = count * 64;
+  constexpr uint32_t physical_size = 1u << 29;
+  if (source_address + length > physical_size || destination + length > physical_size) {
+    return std::nullopt;
+  }
+  return CpuCopyRange{uint32_t(source_address), uint32_t(destination), length};
+}
+
+} // namespace rex::gpu
