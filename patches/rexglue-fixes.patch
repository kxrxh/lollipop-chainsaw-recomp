+void D3D12CommandProcessor::UpdateDrawResolutionScale() {
+  const std::array requested = {GetGraphicsDriver().GetResolutionScaleX(),
+                                GetGraphicsDriver().GetResolutionScaleY()};
+  if (requested == draw_resolution_scale_config_ || submission_open_ || frame_open_) {
+    return;
+  }
+  uint32_t scale_x, scale_y;
+  TextureCache::GetConfigDrawResolutionScale(requested[0], requested[1], scale_x, scale_y);
+  const auto& provider = GetD3D12Provider();
+  D3D12TextureCache::ClampDrawResolutionScaleToMaxSupported(scale_x, scale_y, provider);
+  if (scale_x == texture_cache_->GetDrawResolutionScaleX() &&
+      scale_y == texture_cache_->GetDrawResolutionScaleY()) {
+    draw_resolution_scale_config_ = requested;
+    return;
+  }
+  // Rebind only after all submitted commands have stopped referencing the old caches.
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return;
+  }
+  auto rollback = [&] {
+    constexpr const char* flags[] = {"gpu.resolution_scale_x", "gpu.resolution_scale_y"};
+    for (size_t i = 0; i < requested.size(); ++i) {
+      if (auto result =
+              REX_SETTINGS().SetText(flags[i], std::to_string(draw_resolution_scale_config_[i]));
+          !result) {
+        REXGPU_WARN("Could not restore {}: {}", flags[i], result.error().message);
+      }
+    }
+    REXGPU_ERROR("Could not change draw resolution scale; keeping the previous resources");
+  };
+  auto targets = std::make_unique<D3D12RenderTargetCache>(*register_file_, GetXenosSettings(),
+                                                          physical_memory_, scale_x, scale_y, *this,
+                                                          bindless_resources_used_);
+  if (!targets->Initialize()) {
+    rollback();
+    return;
+  }
+  auto pipelines =
+      std::make_unique<PipelineCache>(*this, *register_file_, *targets, bindless_resources_used_);
+  if (!pipelines->Initialize()) {
+    rollback();
+    return;
+  }
+  auto textures = D3D12TextureCache::Create(*register_file_, GetXenosSettings(), *shared_memory_,
+                                            scale_x, scale_y, *this, bindless_resources_used_);
+  if (!textures) {
+    rollback();
+    return;
+  }
+  auto reload_shader = [&](Shader* shader) -> Shader* {
+    if (!shader) {
+      return nullptr;
+    }
+    auto ucode = shader->GetUcodeData();
+    for (auto& word : ucode) {
+      word = std::byteswap(word);
+    }
+    return pipelines->LoadShader(shader->GetType(), ucode.data(), uint32_t(ucode.size()));
+  };
+  active_vertex_shader_ = reload_shader(active_vertex_shader_);
+  active_pixel_shader_ = reload_shader(active_pixel_shader_);
+  pipeline_cache_->ShutdownShaderStorage();
+  texture_cache_ = std::move(textures);
+  pipeline_cache_ = std::move(pipelines);
+  render_target_cache_ = std::move(targets);
+  if (bindless_resources_used_) {
+    WriteBindlessEDRAMDescriptors(provider);
+  }
+  window_title_state_.store(kWindowTitleStateValid |
+                                static_cast<u32>(render_target_cache_->GetPath()) | (scale_x << 8) |
+                                (scale_y << 16),
+                            std::memory_order_release);
+  InvalidateAllVertexBufferResidency();
+  draw_resolution_scale_config_ = requested;
+  if (!shader_storage_root_.empty()) {
+    pipeline_cache_->InitializeShaderStorage(shader_storage_root_, shader_storage_title_, false);
+  }
+  REXGPU_INFO("Live draw resolution scale applied: {}x{}", scale_x, scale_y);
+}
