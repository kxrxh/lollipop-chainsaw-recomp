+void SetTextureDataCallback(TextureDataCallback callback) {
+  texture_data_callback.store(
+      callback ? std::make_shared<const TextureDataCallback>(std::move(callback)) : nullptr);
+}
+
+bool UpdateTextureData(IPhysicalMemory& memory, u32 address, u32 width, u32 height, u32 format,
+                       u32 size) {
+  auto callback = texture_data_callback.load();
+  if (!callback || !size) {
+    return false;
+  }
+  const auto data = memory.GetReadOnlyPhysicalSpan({address, size});
+  if (!data) {
+    return false;
+  }
+  const auto replacement =
+      (*callback)(width, height, format, {reinterpret_cast<const u8*>(data->data()), size});
+  return replacement.size() == size && memory.CopyToPhysical(address, std::as_bytes(replacement));
+}
+
+void ReportShaderPrecompile(ShaderPrecompileStage stage, u32 completed, u32 total, u32 failed) {
+  if (auto callback = shader_precompile_callback.load()) {
+    (*callback)(stage, completed, total, failed);
+  }
+}
+
+void GraphicsSystem::SetShaderPrecompile(bool blocking, ShaderPrecompileCallback callback) {
+  blocking_shader_precompile_ = blocking;
+  shader_precompile_callback.store(
+      callback ? std::make_shared<const ShaderPrecompileCallback>(std::move(callback)) : nullptr);
+}
