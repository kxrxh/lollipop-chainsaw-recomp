+void D3D12CommandProcessor::UpdateDrawResolutionScale() {
+  const std::array<int32_t, 3> requested = {REXCVAR_GET(resolution_scale),
+                                            REXCVAR_GET(draw_resolution_scale_x),
+                                            REXCVAR_GET(draw_resolution_scale_y)};
+  if (requested == draw_resolution_scale_config_ || submission_open_ || frame_open_) {
+    return;
+  }
+  uint32_t scale_x, scale_y;
+  TextureCache::GetConfigDrawResolutionScale(scale_x, scale_y);
+  const auto& provider = GetD3D12Provider();
+  D3D12TextureCache::ClampDrawResolutionScaleToMaxSupported(scale_x, scale_y, provider);
+  if (scale_x == texture_cache_->draw_resolution_scale_x() &&
+      scale_y == texture_cache_->draw_resolution_scale_y()) {
+    draw_resolution_scale_config_ = requested;
+    return;
+  }
+  // Rebind only after all submitted commands have stopped referencing the old caches.
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return;
+  }
+  auto rollback = [&] {
+    constexpr const char* flags[] = {"resolution_scale", "draw_resolution_scale_x",
+                                     "draw_resolution_scale_y"};
+    for (size_t i = 0; i < requested.size(); ++i) {
+      rex::cvar::SetFlagByName(flags[i], std::to_string(draw_resolution_scale_config_[i]));
+    }
+    REXGPU_ERROR("Could not change draw resolution scale; keeping the previous resources");
+  };
+  auto targets = std::make_unique<D3D12RenderTargetCache>(*register_file_, *memory_, scale_x,
+                                                          scale_y, *this, bindless_resources_used_);
+  if (!targets->Initialize()) {
+    rollback();
+    return;
+  }
+  auto pipelines =
+      std::make_unique<PipelineCache>(*this, *register_file_, *targets, bindless_resources_used_);
+  if (!pipelines->Initialize()) {
+    rollback();
+    return;
+  }
+  auto textures = D3D12TextureCache::Create(*register_file_, *shared_memory_, scale_x, scale_y,
+                                            *this, bindless_resources_used_);
+  if (!textures) {
+    rollback();
+    return;
+  }
+  auto reload_shader = [&](Shader* shader) -> Shader* {
+    if (!shader) {
+      return nullptr;
+    }
+    auto ucode = shader->ucode_data();
+    for (auto& word : ucode) {
+      word = rex::byte_swap(word);
+    }
+    return pipelines->LoadShader(shader->type(), ucode.data(), uint32_t(ucode.size()));
+  };
+  active_vertex_shader_ = reload_shader(active_vertex_shader_);
+  active_pixel_shader_ = reload_shader(active_pixel_shader_);
+  pipeline_cache_->ShutdownShaderStorage();
+  texture_cache_ = std::move(textures);
+  pipeline_cache_ = std::move(pipelines);
+  render_target_cache_ = std::move(targets);
+  if (bindless_resources_used_) {
+    // kEdramRawSRV.
+    render_target_cache_->WriteEdramRawSRVDescriptor(provider.OffsetViewDescriptor(
+        view_bindless_heap_cpu_start_, uint32_t(SystemBindlessView::kEdramRawSRV)));
+    // kEdramR32UintSRV.
+    render_target_cache_->WriteEdramUintPow2SRVDescriptor(
+        provider.OffsetViewDescriptor(view_bindless_heap_cpu_start_,
+                                      uint32_t(SystemBindlessView::kEdramR32UintSRV)),
+        2);
+    // kEdramR32G32UintSRV.
+    render_target_cache_->WriteEdramUintPow2SRVDescriptor(
+        provider.OffsetViewDescriptor(view_bindless_heap_cpu_start_,
+                                      uint32_t(SystemBindlessView::kEdramR32G32UintSRV)),
+        3);
+    // kEdramR32G32B32A32UintSRV.
+    render_target_cache_->WriteEdramUintPow2SRVDescriptor(
+        provider.OffsetViewDescriptor(view_bindless_heap_cpu_start_,
+                                      uint32_t(SystemBindlessView::kEdramR32G32B32A32UintSRV)),
+        4);
+    // kEdramRawUAV.
+    render_target_cache_->WriteEdramRawUAVDescriptor(provider.OffsetViewDescriptor(
+        view_bindless_heap_cpu_start_, uint32_t(SystemBindlessView::kEdramRawUAV)));
+    // kEdramR32UintUAV.
+    render_target_cache_->WriteEdramUintPow2UAVDescriptor(
+        provider.OffsetViewDescriptor(view_bindless_heap_cpu_start_,
+                                      uint32_t(SystemBindlessView::kEdramR32UintUAV)),
+        2);
+    // kEdramR32G32UintUAV.
+    render_target_cache_->WriteEdramUintPow2UAVDescriptor(
+        provider.OffsetViewDescriptor(view_bindless_heap_cpu_start_,
+                                      uint32_t(SystemBindlessView::kEdramR32G32UintUAV)),
+        3);
+    // kEdramR32G32B32A32UintUAV.
+    render_target_cache_->WriteEdramUintPow2UAVDescriptor(
+        provider.OffsetViewDescriptor(view_bindless_heap_cpu_start_,
+                                      uint32_t(SystemBindlessView::kEdramR32G32B32A32UintUAV)),
+        4);
+  }
+  InvalidateAllVertexBufferResidency();
+  draw_resolution_scale_config_ = requested;
+  if (!shader_storage_root_.empty()) {
+    pipeline_cache_->InitializeShaderStorage(shader_storage_root_, shader_storage_title_, false);
+  }
+  REXGPU_INFO("Live draw resolution scale applied: {}x{}", scale_x, scale_y);
+}
