+void PipelineCache::CompletePrecompile(Pipeline* pipeline) {
+  if (!pipeline->precompile) return;
+  pipeline->precompile = false;
+  if (!pipeline->state.load(std::memory_order_acquire)) ++precompile_failed_;
+  system::ReportShaderPrecompile(system::ShaderPrecompileStage::kPipelines,
+      ++precompile_completed_, precompile_total_, precompile_failed_.load());
+}
