+namespace {
+std::atomic<std::shared_ptr<const ShaderPrecompileCallback>> shader_precompile_callback;
+}
+
+void SetShaderPrecompileCallback(ShaderPrecompileCallback callback) {
+  shader_precompile_callback.store(callback
+      ? std::make_shared<const ShaderPrecompileCallback>(std::move(callback)) : nullptr);
+}
+
+void ReportShaderPrecompile(ShaderPrecompileStage stage, uint32_t completed,
+                            uint32_t total, uint32_t failed) {
+  auto callback = shader_precompile_callback.load();
+  if (callback) (*callback)(stage, completed, total, failed);
+}
+
 }  // namespace rex::system
