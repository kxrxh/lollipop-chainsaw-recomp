<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lollipop Chainsaw Recomp" Width="1080" Height="720" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#211722" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#32232E"/>
      <Setter Property="Background" Value="#FFFCF5"/>
      <Setter Property="BorderBrush" Value="#C9BFC0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,13"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#A20D4F"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Step" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#4F3B47"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="48*"/><ColumnDefinition Width="52*"/></Grid.ColumnDefinitions>
    <Grid ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality">
      <Grid.Background><ImageBrush x:Name="Cover" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Grid.Background>
      <Grid Margin="36,28,36,24">
        <StackPanel VerticalAlignment="Top">
          <TextBlock Text="LOLLIPOP" FontFamily="Impact" FontSize="62" Foreground="#FFF9EC"/>
          <TextBlock Text="CHAINSAW" FontFamily="Impact" FontSize="62" Foreground="#FFF9EC" Margin="0,-17,0,0"/>
          <TextBlock Text="R E C O M P" FontSize="13" FontWeight="Bold" Foreground="#FF77B0" Margin="2,6,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Column="1" BorderBrush="#EC3D7D" BorderThickness="3,0,0,0">
      <Border.Background><ImageBrush x:Name="Paper" Stretch="UniformToFill"/></Border.Background>
      <Grid Margin="42,34,42,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#D8CAD0" BorderThickness="0,0,0,1">
          <UniformGrid Columns="3">
            <TextBlock Name="DiscTab" Text="01 / SETUP" Style="{StaticResource Step}"/>
            <TextBlock Name="SetupTab" Text="02 / INSTALL" Style="{StaticResource Step}" HorizontalAlignment="Center"/>
            <TextBlock Name="PlayTab" Text="03 / PLAY" Style="{StaticResource Step}" HorizontalAlignment="Right"/>
          </UniformGrid>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="0,32,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <TextBlock Name="Heading" FontFamily="Impact" FontSize="40" Foreground="#2B1B29" TextWrapping="Wrap"/>
            <TextBlock Name="Description" FontSize="14" LineHeight="22" Foreground="#65515E" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock Name="Location" FontSize="12" Foreground="#65515E" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <ProgressBar Name="Progress" Height="6" Margin="0,24,0,0" IsIndeterminate="True" Foreground="#D12266" Background="#E8DCE0" BorderThickness="0" Visibility="Collapsed"/>
            <TextBlock Name="StepStatus" FontSize="12" Foreground="#8A2551" Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel Name="Inputs" Margin="0,24,0,8">
              <TextBlock Text="Disc image" Style="{StaticResource FieldLabel}"/>
              <Button Name="ChooseIso" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Choose Xbox 360 disc image">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="Browse" Foreground="#AA1B55" FontWeight="SemiBold" Margin="12,0,0,0"/>
                  <TextBlock Name="IsoName" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Button>
              <TextBlock Text="Install folder" Style="{StaticResource FieldLabel}" Margin="0,22,0,8"/>
              <Button Name="ChooseFolder" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Choose install folder">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="Browse" Foreground="#AA1B55" FontWeight="SemiBold" Margin="12,0,0,0"/>
                  <TextBlock Name="FolderName" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Button>
            </StackPanel>
            <Expander Name="ErrorLog" Header="Full setup log" Visibility="Collapsed" Margin="0,20,0,0" Foreground="#4F3B47">
              <TextBox Name="LogText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"
                       Background="#281C29" Foreground="#FFF4EC" BorderThickness="0" Padding="12" Margin="0,8,0,0"
                       MinHeight="160" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Full setup log"/>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,24,0,0">
          <Button Name="Precompile" Content="Precompile shaders" Margin="0,0,0,10" HorizontalContentAlignment="Center" Visibility="Collapsed"
                  ToolTip="Prepare the available pipeline inventory. Coverage depends on the recorded scenes."/>
          <Button Name="Primary" IsDefault="True" Background="#D12266" Foreground="White" BorderBrush="#D12266"
                  FontSize="16" FontWeight="SemiBold" MinHeight="52" HorizontalContentAlignment="Center"/>
          <Button Name="Secondary" Margin="0,10,0,0" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,18,0,0">
          <Button Name="Help" Content="Setup help" Padding="0,3" FontSize="12" BorderThickness="0"
                  HorizontalAlignment="Right" Background="Transparent" Foreground="#715365"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
